# Tout le site en HTTPS, sans exception.
#
# Sur l'hébergement mutualisé d'OVH, la requête arrive en clair au serveur
# Apache même quand le visiteur est en HTTPS : c'est l'en-tête posé par le
# répartiteur qui dit la vérité. On teste donc les deux, sans quoi la règle
# boucle indéfiniment.
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Une page absente répond « absente », et non la page d'accueil.
ErrorDocument 404 /404.html

# Pas d'inventaire des dossiers : /medias/ listait tous ses fichiers.
Options -Indexes

# En-têtes de sécurité. Le site ne charge rien de l'extérieur et ne se laisse
# pas encadrer par une autre page.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
