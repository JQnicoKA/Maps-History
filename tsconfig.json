{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `supabase/functions` est du Deno : il importe par URL, connaît l'objet
  // global `Deno`, et n'a rien à voir avec le bundle de l'application. Le
  // laisser dans le périmètre faisait échouer `tsc` sur du code parfaitement
  // valide chez lui.
  "exclude": ["node_modules", "supabase/functions"]
}
